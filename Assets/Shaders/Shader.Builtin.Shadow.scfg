# Shadow shader config file
version=1.0
name=Shader.Builtin.Shadow
language=glsl
renderpass=Renderpass.Builtin.Shadow
stages=vertex,fragment
stagefiles=Shaders/Shader.Builtin.Shadow.vert.spv,Shaders/Shader.Builtin.Shadow.frag.spv

# 1=enable, 0=disable
depth_test=1
depth_write=1

# line / fill
polygon_mode=fill

# Attributes: type,name
attribute=vec3,in_position

# Uniforms: type,scope,name
# NOTE: For scope: 0=global, 1=instance, 2=local
uniform=mat4,0,light_space_matrix
uniform=mat4,2,model
